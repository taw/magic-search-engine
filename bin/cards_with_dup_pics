#!/usr/bin/env ruby

require_relative "../search-engine/lib/card_database"
require_relative "../search-engine/lib/card_picture_paths"

class Array
  def all_same?
    uniq.size == 1
  end
end

class CardsWithBadDfcPics
  attr_reader :db

  def initialize(*args)
    if args == []
      @delete = false
    elsif args == ["--delete"]
      @delete = true
    else
      STDERR.puts "Usage: #{$0} [--delete]"
      exit 1
    end
    @db = CardDatabase.load
  end

  def lq_dups
    @lq_dups ||= db
      .printings
      .group_by(&:path_lq_sha1)
      .select{|k,v| k and v.size > 1}
  end

  def hq_dups
    @hq_dups ||= db
      .printings
      .group_by(&:path_hq_sha1)
      .select{|k,v| k and v.size > 1}
  end

  def evaluate_dup(kind, pics)
    if pics.map{|c| PhysicalCard.for(c) }.all_same?
      # split/aftermath/etc.
      return if pics.all?(&:front?)

      fail_type = "duplicate for DFC"
    else
      # They have same fronts, different backs
      if pics.map(&:set_code).sort == ["ced", "cei"] and pics.map(&:name).all_same? and pics.map(&:number).all_same?
        return
      end

      bad = pics.map{|c| "#{c.set_code}/#{c.number} #{c.name}"}.join(", ")
      fail_type = "duplicate for unrelated cards"
    end

    bad = pics.map{|c| "#{c.set_code}/#{c.number} #{c.name}"}.join(", ")
    puts "#{kind} #{fail_type}: #{bad}"

    # HQ pics can't be refetched, so only drop the LQ ones
    if @delete and kind == "LQ"
      pics.each do |c|
        puts "Deleting #{c.path_lq}"
        c.path_lq.delete
      end
    end
  end

  def call
    lq_dups.each do |_, pics|
      evaluate_dup("LQ", pics)
    end

    hq_dups.each do |_, pics|
      evaluate_dup("HQ", pics)
    end
  end
end

CardsWithBadDfcPics.new(*ARGV).call
