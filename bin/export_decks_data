#!/usr/bin/env ruby

require_relative "../search-engine/lib/card_database"
require "optparse"

class ExportDecksData
  def initialize(simple_sections: false)
    @simple_sections = simple_sections
    @db = CardDatabase.load
    @uuids_path = Pathname("#{__dir__}/../index/uuids.txt")
    @token_uuids_path = Pathname("#{__dir__}/../index/token_uuids.txt")
    load_uuids
    load_token_uuids
  end

  def load_uuids
    @uuids = {}
    @uuids_path.each_line do |line|
      s, n, u, _ = line.chomp.split("\t")
      @uuids[s] ||= {}
      raise if @uuids[s][n]
      @uuids[s][n] = u
    end
  end

  def load_token_uuids
    @token_uuids = {}
    @token_names = {}
    @token_uuids_path.each_line do |line|
      _, token_set_code, number, uuid, name = line.chomp.split("\t")
      @token_uuids[token_set_code] ||= {}
      @token_names[token_set_code] ||= []
      @token_names[token_set_code] << [name, number]
      if @token_uuids[token_set_code][number]
        # mtgjson changed how it encodes them
        raise "Old style double sided token #{token_set_code} #{number} #{name}, it shouldn't happen anymore"
      else
        @token_uuids[token_set_code][number] = uuid
      end
    end
  end

  def uuid_for(set_code, number)
    @uuids.fetch(set_code).fetch(number)
  end

  def token_uuid_for(name, set_code, number)
    set_code = set_code&.downcase
    @token_uuids.fetch(set_code).fetch(number)
  rescue
    if set_code.nil?
      message = "Set was not specified"
    elsif @token_names[set_code].nil?
      message = "Set has no token information"
    else
      options = @token_names[set_code].select{|n, | n == name}
      if options&.empty?
        message = "Set only has tokens: #{@token_names[set_code].map(&:first).uniq.sort.join(", ")}"
      else
        message = "Options are: #{options.map(&:last).sort.join(", ")}"
      end
    end
    warn "Could not find token #{name} [#{set_code || "unknown"}:#{number || "unknown"}]. #{message}"
    "not_in_mtgjson"
  end

  def export_card(n, c)
    {
      name: c.name,
      set_code: c.set_code,
      number: c.number,
      foil: c.foil,
      etched: c.etched ? true : nil,
      count: n,
      multiverseid: c.main_front.multiverseid,
      mtgjson_uuid: uuid_for(c.set_code, c.number),
    }.compact
  end

  def export_token(count, name, set_code, number, foil)
    # For double sided tokens, name keeps both sides, set and number are split into front and back
    if set_code&.include?(" // ")
      (name, set_code, number), (back_name, back_set_code, back_number) = Deck.token_sides(name, set_code, number)
      back_mtgjson_uuid = token_uuid_for(back_name, back_set_code, back_number)
    end
    {
      back_mtgjson_uuid: back_mtgjson_uuid,
      back_name: back_name,
      back_number: back_number,
      back_set_code: back_set_code,
      count: count,
      foil: foil,
      mtgjson_uuid: token_uuid_for(name, set_code, number),
      name: name,
      number: number || "unknown",
      set_code: set_code || "unknown",
    }.compact
  end

  def deck_source_set_codes(deck)
    (deck.all_set_codes | deck.all_token_set_codes.map{|code| @db.token_set_code_to_set_code.fetch(code) }).sort
  end

  def deck_sections(deck)
    if @simple_sections
      {
        sideboard: deck.sideboard_and_commander.map{|n,c| export_card(n, c) },
      }
    else
      {
        sideboard: deck.section("Sideboard").map{|n,c| export_card(n, c) },
        commander: deck.commander.map{|n,c| export_card(n, c) },
        displayCommander: deck.section("Display Commander").map{|n,c| export_card(n, c) },
        planarDeck: deck.section("Planar Deck").map{|n,c| export_card(n, c) },
        schemeDeck: deck.section("Scheme Deck").map{|n,c| export_card(n, c) },
      }
    end
  end

  def call(output_path)
    exported_data = []
    @db.decks.each do |deck|
      exported_data << {
        name: deck.name,
        type: deck.type,
        category: deck.category,
        format: deck.format,
        set_code: deck.set_code,
        set_name: deck.set_name,
        release_date: deck.release_date,
        cards: deck.cards.map{|n,c| export_card(n, c) },
        **deck_sections(deck),
        tokens: deck.tokens.map{|c| export_token(*c) },
        languages: Array(deck.languages),
        sourceSetCodes: deck_source_set_codes(deck),
        source: deck.source,
      }
    end
    open(output_path, "w") do |fh|
      fh.puts JSON.pretty_generate(exported_data)
    end
  end
end

simple_sections = false
OptionParser.new do |o|
  o.banner = "Usage: export_decks_data [--simple-sections] [OUTPUT_PATH]"
  o.on("--simple-sections", "merge commander and extra sections into sideboard") { simple_sections = true }
end.parse!

output_path = ARGV[0] || "export_decks.json"
ExportDecksData.new(simple_sections: simple_sections).call(output_path)
