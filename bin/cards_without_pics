#!/usr/bin/env ruby

require_relative "../search-engine/lib/card_database"
require_relative "../search-engine/lib/card_picture_paths"

class CardsWithoutPics
  attr_reader :db

  def initialize
    @db = CardDatabase.load
  end

  def missing
    @missing ||= db
      .printings
      .reject{|card| card.path_hq.exist? or card.path_lq.exist? }
      .sort_by{|c| [c.set, c.number.to_i, c.number] }
  end

  def call
    missing.each do |c|
      puts "#{c.set_code}/#{c.number} #{c.name}"
      if c.number =~ /\A(.*)[ab]/
        if CardPicturePaths.lq(c.set_code, $1).exist?
          puts "- LQ exists as #{c.set_code}/#{$1}"
        end
        if CardPicturePaths.hq(c.set_code, $1).exist?
          puts "- HQ exists as #{c.set_code}/#{$1}"
        end
      end
    end
  end

  def show_sets
    missing_sets = missing.map(&:set_code).uniq.sort
    puts missing_sets.join("\n") unless missing_sets.empty?
  end
end

if ARGV[0] == "--sets"
  CardsWithoutPics.new.show_sets
else
  CardsWithoutPics.new.call
end
