#!/usr/bin/env ruby

# Exports every B&R announcement we know about, for every format, as:
#   {"modern": [{"date": "2011-09-20", "url": "...", "comment": null, "changes": {"Jace, the Mind Sculptor": "banned"}}, ...], ...}
#
# Source is either url or comment.
# Some old banlist changes have no source.
#
# Initial entry has start of format date if known, or null if unknown.
#
# Possible legalities:
# * legal - normal rules apply
# * banned - cannot be used in any way
# * restricted - 1 copy only
# * banned_as_commander - legal, but cannot be used as commander
# * banned_as_companion - legal, but cannot be used as companion
# * conjurable - cannot be used in deck construction, but can be conjured during the game
# * specialized - cannot be used in deck construction, but can be specialized during the game
#
# More niche legalities like "prebanned", "suspended", "banned except in precons" etc. not handled.
#
# Penny Dreadful legality exists outside the banlist system.

require "date"
require "json"
require "pathname"
require_relative "../search-engine/lib/ban_list"

data = BanList.all_ban_lists.map do |ban_list|
  announcements = ban_list.changes.map do |event|
    {
      "date" => (event[:date] == BanList::START ? nil : event[:date].to_s),
      "url" => event[:url],
      "comment" => event[:comment],
      "changes" => event[:changes],
    }
  end
  [ban_list.format, announcements]
end.to_h

json = JSON.pretty_generate(data)

if ARGV.empty?
  puts json
else
  Pathname(ARGV[0]).write(json + "\n")
end
