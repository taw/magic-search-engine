#!/usr/bin/env ruby

require_relative "../search-engine/lib/card_database"
require "memoist"
require "pry"
require "zlib"

class ReportLegalityDifferences
  extend Memoist

  attr_reader :mtgjson_legalities_data

  def initialize(formats=[])
    @formats = formats.map(&:downcase)
    @db = CardDatabase.load
    @mtgjson = JSON.parse(Zlib::GzipReader.open("#{__dir__}/../tmp/AllSets.json.gz", &:read))
    load_mtgjson_legalities_data
  end

  # v4 vs v5
  memoize def all_sets
    if @mtgjson.keys.sort == ["data", "meta"]
       @mtgjson["data"]
    else
       @mtgjson
    end
  end

  # This method mostly just verifies and filters out data
  # It's not in very convenient format
  def load_mtgjson_legalities_data
    @mtgjson_legalities_data = {}
    @mtgjson_future_cards = Set[]
    all_sets.each do |set_code, set_data|
      # Name conflicts
      next if %W[CMB1 CMB2 TBTH].include?(set_code)
      # Cards not legal in any format
      next if %W[CED CEI 30A OAFC OMIC].include?(set_code)

      set_data["cards"].each do |card|
        next if card["isOversized"]
        # pointless name conflicts, legality of mainfront is enough
        next if card["layout"] == "prepare" and card["faceName"] == card["name"].split(" // ").last

        name = card["faceName"] || card["name"]
        name = alchemy_name_fix(name)
        name = unicode_name_fix(name)
        # Cards not out yet won't have legality information on either side
        release_date = card["originalReleaseDate"] || set_data["releaseDate"]
        @mtgjson_future_cards << name if !release_date or Date.parse(release_date) > today
        legalities = card["legalities"].dup
        # Various non-legal oversized etc. cards, just ignore them
        next if legalities == {}
        # It's a stupid fake format not following per-card legality rules
        legalities.delete "oldschool"
        @mtgjson_legalities_data[name] ||= legalities
        if @mtgjson_legalities_data[name] != legalities
          warn "Internally inconsistent legalities for #{name}"
          binding.pry
        end
      end
    end
  end

  memoize def today
    Date.today
  end

  # Any card with a printing not out yet, according to either data source.
  # mtgjson doesn't have legalities for such cards, and an upcoming printing
  # can also change legality of an old card (Standard, Pioneer, Modern, etc.)
  memoize def future_cards
    result = @mtgjson_future_cards.dup
    @db.cards.each_value do |card|
      result << card.name if card.printings.any?{|printing| printing.release_date > today}
    end
    result
  end

  # mtgjson (and scryfall) "future" data is garbage ever since WotC moved
  # Standard rotation date, ours is correct, so there's nothing to compare
  IGNORED_FORMATS = %W[future]

  memoize def mtgjson_formats
    mtgjson_legalities_data.values.map(&:keys).flatten.uniq.sort - IGNORED_FORMATS
  end

  memoize def mtgjson_format_legalities
    result = {}
    mtgjson_legalities_data.each do |card_name, legalities|
      legalities.each do |format_name, status|
        result[format_name] ||= {}
        result[format_name][card_name] = status.downcase
      end
    end
    result
  end

  def verify_format(name)
    return if Format[name] == FormatUnknown
    format = Format[name].new
    mtgjson_legalities = mtgjson_format_legalities[name]
    db_legalities = @db.cards.values.reject{|c| c.layout == "prepare" and c.secondary? }.map{|c| [c.name, format.legality(c)] }.select(&:last).to_h
    card_names = (mtgjson_legalities.keys | db_legalities.keys)

    statuses = []
    card_names.sort.each do |name|
      next if future_cards.include?(name)
      a = mtgjson_legalities[name]
      b = db_legalities[name]
      # mtgjson doesn't make this distinction, it just says "restricted"
      if ["banned_as_commander", "banned_as_companion"].include?(b)
        b = "restricted"
      end
      # Just ignore "banned" vs "not in format" distinction
      if (a || "banned") == (b || "banned")
        statuses << [name, a, a]
        next
      end

      # mtgjson just can't handle meld for penny, no point reporting it
      if format.format_name == "penny dreadful"
        card = @db.cards[name.downcase]
        next if card and card.layout == "meld" and card.names.size == 3
      end

      # This is technically not a B&R issue, so mtgjson reports these cards as either
      # not in format or banned, and we have no reason to prefer one over the other
      if ["conjurable", "specialized"].include?(b) and [nil, "banned"].include?(a)
        b = a
      end
      statuses << [name, a, b]
    end
    differences = statuses.select{|_,a,b| a != b}

    return if differences.empty?

    puts "Format #{name} - #{differences.size} / #{statuses.size} differences"
    differences.sort.each do |name, a, b|
      puts "* #{name} - mtgjson:#{a || 'not it format'} - db:#{b || 'not in format'}"
    end
    puts ""
  end

  # Same fixes as indexer does, as these names contain
  # impossible to search Unicode characters
  UNICODE_NAME_FIXES = {
    "Ratonhnhaké꞉ton" => "Ratonhnhakéton",
    "Human—Time Lord Meta-Crisis" => "Human-Time Lord Meta-Crisis",
  }

  def unicode_name_fix(name)
    UNICODE_NAME_FIXES.fetch(name, name)
  end

  def alchemy_name_fix(name)
    return unless name
    name.split(" // ").map{|s|
      if s =~ /\AA-(.*)/
        "#{$1} (Alchemy)"
      else
        s
      end
    }.join(" // ")
  end

  memoize def formats_to_check
    return mtgjson_formats if @formats.empty?
    unknown = @formats - mtgjson_formats
    unless unknown.empty?
      raise "Unknown format#{"s" if unknown.size > 1}: #{unknown.join(", ")} - known formats: #{mtgjson_formats.join(", ")}"
    end
    @formats
  end

  def call
    formats_to_check.each do |name|
      verify_format name
    end
  end
end

ReportLegalityDifferences.new(ARGV).call
