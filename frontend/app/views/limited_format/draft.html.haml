%h3= @limited_format.to_s
%p Open these packs in order:
%ol
  - @limited_format.booster_order.each do |pack|
    %li
      = link_to_pack(pack) do
        = pack.name
      = "(#{pack.code.upcase})"
= render "draft_rules", limited_format: @limited_format
%p Drafting is not supported on this website.
