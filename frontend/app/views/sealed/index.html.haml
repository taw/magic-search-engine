%h1 Sealed
%form.sealed_form
  - @packs_to_open.each_with_index do |(set_code, count), i|
    .pack_selection
      %input.form-control.pack_count{type: "number", name: "count[]", value: count, min: 0, id: "count_#{i}", "aria-label": "Number of packs"}
      = select_tag "set[]", options_for_select(@booster_options, set_code), id: "set_#{i}", class: "form-control pack_set", "aria-label": "Booster type"
  .fixed_cards
    %label{for: "fixed"} Optional fixed cards
    %textarea.form-control.fixed{id: "fixed", name: "fixed", rows: 3, placeholder: "1x mh1:255\n1x m19:306:foil"}= @fixed
  %button{type: "submit", class: "btn btn-outline-primary"}
    Open packs
- if @warnings.present?
  .row
    .col-12.warnings
      - @warnings.each do |warning|
        .warning= warning
- if @cards.present?
  = form_tag("/deck/visualize", method: :post, enforce_utf8: false, class: "sealed_preview_form") do
    %input{type: "hidden", name: "deck", value: @deck}
    %button.btn.btn-outline-primary
      Preview as Deck
    -# Exporting a pool is what most people want the visualizer for, so it is
    -# offered here rather than one page further on
    %button.btn.btn-outline-primary{type: "button", "data-toggle": "modal", "data-target": "#deck_export"}
      Export
  = render "deck/export_dialog", deck: nil
  .row.multicard_row
    - @cards.each_with_index do |card, i|
      .col-4.col-sm-3.card_picture_cell
        = link_to_card(card.main_front) do
          = render 'card/picture', card: card, searchable: true
