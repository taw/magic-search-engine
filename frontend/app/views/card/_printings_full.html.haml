%h5 Printings
%ul.printings_list
  - printings.each do |(set_name, rarity), set_printings|
    %li
      - if set_printings.size == 1
        - set_printings.each do |type, printing|
          - case type
          - when :selected
            %span.selected
              = printing.set_name
          - when :matching
            %span.matching
              = link_to_card(printing) do
                = printing.set_name
          - else
            %span.not_matching
              = link_to_card(printing) do
                = printing.set_name
          %span.rarity= "(#{rarity})"
      - else
        - if set_printings.map(&:first).any?{|type| type == :selected}
          %span.selected
            = set_name
        - elsif set_printings.map(&:first).any?{|type| type == :matching}
          %span.matching
            = set_name
        - else
          %span.not_matching
            = set_name
          &mdash;
        - set_printings.each do |type, printing|
          - case type
          - when :selected
            %span.selected
              = printing.number
          - when :matching
            %span.matching
              = link_to_card(printing) do
                = printing.number
          - else
            %span.not_matching
              = link_to_card(printing) do
                = printing.number
        %span.rarity= "(#{rarity})"
- availability = $CardDatabase.availability(card)
- unless availability.empty?
  %p.infolabel
    Availability:
  %ul.printings_list
    - availability.each do |entry|
      %li
        = link_to_availability(entry) do
          = availability_name(entry)
        - if entry.finish_label
          %span.finishes= "(#{entry.finish_label})"
%p.infolabel
  = link_to "View gallery of all printings", card_gallery_path(card)
