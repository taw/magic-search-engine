%h5 Legalities
%ul.legalities
  -# CardController#show precomputes this for @card. Index views render many cards,
  -# so there's nothing to hoist and they compute it here.
  - legality = @legality || card.legality_information
  -# A printing you can't bring to a sanctioned event, or can't get at all, while the
  -# card itself has legality from elsewhere. is:tournament covers oversized and
  -# gold-bordered printings as well as playtest, silver-bordered and acorn ones.
  - printing_not_legal = card.nontournament || !(card.paper? or card.mtgo? or card.arena?)
  - if legality.legal_everywhere?
    - if printing_not_legal
      %li This printing of #{card.name} is not legal. The card has other legal printings.
    %li
      #{card.name} is legal in every format.
  - elsif legality.legal_nowhere?
    %li
      #{card.name} is not legal in any format.
  - else
    - if printing_not_legal
      %li This printing of #{card.name} is not legal. The card has other legal printings.
    - if card.card.not_released_yet?
      %li This card is not released yet. Legality information only applies after its release.
    - legality.to_h.sort.each do |format_name, status|
      %li
        %i{class: "legality-#{status.tr("_", "-")}"}= status.tr("_", " ")
        = link_to format_name, format_url(format_name)
