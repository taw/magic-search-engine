#!/usr/bin/env ruby

require_relative "../lib/card_database"
require_relative "../lib/sealed"

class OpenPacksJSON
  attr_reader :db

  def initialize
    @db = CardDatabase.load
    load_uuids
  end

  def sealed
    @sealed ||= Sealed.new(db, *ARGV)
  end

  def uuids_path
    Pathname("#{__dir__}/../../index/uuids.txt")
  end

  def load_uuids
    @uuids = {}
    uuids_path.each_line do |line|
      s, n, u, _ = line.chomp.split("\t")
      @uuids[s] ||= {}
      raise if @uuids[s][n]
      @uuids[s][n] = u
    end
  end

  def uuid_for(set_code, number)
    @uuids.fetch(set_code).fetch(number)
  end

  def open_some_packs
    cards = sealed.call

    data = cards.map{|card, count|
      {
        name: card.name,
        set: card.set_code,
        count: count,
        number: card.number,
        uuid: uuid_for(card.set_code,
        card.number),
        foil: card.foil,
        etched: (true if card.etched),
      }.compact
    }.sort_by{|c|
      [c[:name], c[:set], c[:number]]
    }
    puts JSON.pretty_generate(data)
  end

  def call
    open_some_packs
  end
end

if ARGV.empty?
  STDERR.puts <<~EOF
  Open packs. You can also add predefined cards to the results. Returns JSON.

  Counts need a space after them, so quote them for the shell.

  Usage:
    #{$0} m10
    #{$0} "6x m10"
    #{$0} "36 m10"
    #{$0} "36x mh1" mh1/255
    #{$0} "36x m19" "2x m19/306/foil"
    #{$0} "10x cmr-collector" cmr/559/etched
    #{$0} "10x iko-collector"
    #{$0} "2x som" "2x mbs" "2x nph"
  EOF
  exit 1
end

begin
  OpenPacksJSON.new.call
rescue RuntimeError => e
  # Bad descriptors are a usage error, and `36xm10` is now one of them
  STDERR.puts e.message
  exit 1
end
