#!/usr/bin/env ruby

# Loading the index leaves the process much larger than the objects it ended up
# keeping. Most of that gap is not Ruby's object heap - it's memory glibc took
# from the OS for all the short-lived strings the load allocated and then held
# on to instead of giving back.
#
# This measures the gap and how much of it malloc_trim can return, which is
# something only a glibc machine can answer - on macOS it just reports the gap.
#
# Worth also comparing against, on the server:
#   MALLOC_ARENA_MAX=2 bin/memory_arena_check
#   LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2 bin/memory_arena_check

require "objspace"
require_relative "../lib/card_database"

def rss_mb
  if RUBY_PLATFORM =~ /linux/
    File.read("/proc/self/status")[/VmRSS:\s*(\d+)/, 1].to_i / 1024.0
  else
    `ps -o rss= -p #{$$}`.to_i / 1024.0
  end
end

def malloc_trim
  require "fiddle"
  handle = Fiddle::Handle.new
  fn = Fiddle::Function.new(handle["malloc_trim"], [Fiddle::TYPE_SIZE_T], Fiddle::TYPE_INT)
  fn.call(0)
  true
rescue Fiddle::DLError, NameError, LoadError
  false
end

peak = 0
watcher = Thread.new do
  loop do
    current = rss_mb
    peak = current if current > peak
    sleep 0.05
  end
end

db = CardDatabase.load
db.printings
3.times { GC.start }
watcher.kill

settled = rss_mb
heap_slots = GC.stat(:heap_available_slots) * GC::INTERNAL_CONSTANTS[:RVALUE_SIZE] / 1024.0 / 1024
live = ObjectSpace.memsize_of_all / 1024.0 / 1024

puts "peak RSS during load   %6.0f MB" % peak
puts "settled RSS            %6.0f MB" % settled
puts "  Ruby heap slots      %6.0f MB" % heap_slots
puts "  live objects         %6.0f MB  (memsize_of_all, includes the slots)" % live
puts "  unaccounted for      %6.0f MB  <- allocator slack, what trimming can target" % (settled - live)

if malloc_trim
  after = rss_mb
  puts
  puts "after malloc_trim(0)   %6.0f MB  (released %.0f MB)" % [after, settled - after]
else
  puts
  puts "malloc_trim unavailable on this platform - run this on the server for the real number"
end
